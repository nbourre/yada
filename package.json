{
  "name": "yada",
  "version": "1.0.0",
  "description": "YADA - Yet Another Database Analyzer - FileMaker DDR XML analysis tool",
  "main": "dist/main/index.js",
  "scripts": {
    "electron": "electron dist/main/index.js",
    "electron:dev": "concurrently \"npm run build:main:watch\" \"npm run dev:server\" \"wait-on http://localhost:3000 && electron dist/main/index.js\"",
    "dev": "npm run dev:server",
    "dev:server": "concurrently \"npm run build:main:watch\" \"nodemon dist/server/server/index.js\"",
    "build": "npm run clean && npm run build:main && npm run build:server && npm run build:renderer",
    "build:main": "tsc -p src/main/tsconfig.json",
    "build:main:watch": "tsc -p src/main/tsconfig.json --watch",
    "build:server": "tsc -p src/server/tsconfig.json",
    "build:renderer": "webpack --mode production",
    "dev:renderer": "webpack serve --mode development",
    "start": "node dist/server/server/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "lint": "eslint src/ tests/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ tests/ --ext .ts,.tsx --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist/",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir"
  },
  "keywords": [
    "filemaker",
    "ddr",
    "xml",
    "parser",
    "electron",
    "desktop",
    "cross-platform",
    "typescript"
  ],
  "author": "FileMaker DDR Explorer Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.19",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "css-loader": "^6.11.0",
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "playwright": "^1.55.1",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.10",
    "style-loader": "^3.3.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.1",
    "webpack": "^5.102.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.16.9",
    "@mui/material": "^5.18.0",
    "@mui/x-data-grid": "^7.22.2",
    "@types/cors": "^2.8.19",
    "@types/cytoscape": "^3.21.9",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node-fetch": "^2.6.13",
    "cors": "^2.8.5",
    "cytoscape": "^3.33.1",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.3.1",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "saxes": "^6.0.0",
    "sql.js": "^1.13.0"
  },
  "build": {
    "appId": "com.filemaker-ddr-explorer.app",
    "productName": "FileMaker DDR Explorer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
